APP_LISTEN_ADDR=:8080
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
APP_SESSION_TTL=12h
APP_SECURE_COOKIES=true
APP_DATABASE_PATH=/var/lib/nvr-evidence/hikvision.db
APP_EXPORT_ROOT=/mnt/evidence
APP_LOG_LEVEL=info
APP_REQUEST_TIMEOUT=45s
APP_MAX_CONCURRENT_EXPORTS=4
APP_ENCRYPTION_KEY=change-me-before-first-run
APP_FFMPEG_PATH=ffmpeg
APP_PRESERVE_RAW=true
APP_ALLOW_CUSTOM_DESTINATIONS=true
