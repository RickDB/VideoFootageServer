# Docker Compose image selection. Pin HIKFOOTAGE_IMAGE_TAG in production.
HIKFOOTAGE_IMAGE=ghcr.io/rickdb/hikfootageserver
HIKFOOTAGE_IMAGE_TAG=latest
HIKFOOTAGE_PORT=8080

# Bootstrap administrator. Change the password before the first deployment.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-now
APP_SESSION_TTL=12h
# Set true when the browser reaches this app through HTTPS.
APP_SECURE_COOKIES=false

APP_LISTEN_ADDR=:8080
APP_DATABASE_PATH=./data/hikvision.db
APP_EXPORT_ROOT=./exports
APP_LOG_LEVEL=info
APP_REQUEST_TIMEOUT=30s
APP_MAX_CONCURRENT_EXPORTS=2

# Set a long, stable secret before adding production recorder credentials.
# Changing it later makes existing encrypted passwords unreadable.
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Recorder-native downloads are remuxed losslessly when FFmpeg is available.
APP_FFMPEG_PATH=ffmpeg
APP_PRESERVE_RAW=true

# False restricts site/job destinations to subfolders of APP_EXPORT_ROOT.
APP_ALLOW_CUSTOM_DESTINATIONS=false
